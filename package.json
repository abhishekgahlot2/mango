{
  "name": "mango-a2a",
  "version": "0.1.0",
  "description": "Local activity board for coding agents",
  "type": "module",
  "engines": { "bun": ">=1.3.0" },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && bun build cli/mango.ts --target=bun --outfile=dist/cli.js",
    "prepack": "bun run build",
    "test": "bun test",
    "mango": "bun cli/mango.ts",
    "serve": "bun cli/mango.ts serve"
  },
  "devDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadow-plugin": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "bin": {
    "mango": "./dist/cli.js"
  }
}
